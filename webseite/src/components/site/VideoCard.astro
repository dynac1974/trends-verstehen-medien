---
import Icon from "./Icon.astro";
import { shortDate, type Video } from "../../lib/site";
interface Props { video: Video }
const { video } = Astro.props;
---
<a href={video.url} target="_blank" rel="noopener" class="group block no-underline">
  <div class:list={["relative overflow-hidden rounded-lg bg-secondary", video.short ? "aspect-[9/16]" : "aspect-video"]}>
    <img src={video.thumb} alt="" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.04]" />
    <span class="absolute inset-0 grid place-items-center bg-foreground/0 transition-colors group-hover:bg-foreground/20">
      <span class="grid h-14 w-14 place-items-center rounded-full bg-youtube text-white opacity-90 shadow-lg transition-transform group-hover:scale-110"><Icon name="play" class="ml-0.5 h-6 w-6" /></span>
    </span>
    {video.short && <span class="absolute left-2 top-2 rounded-control bg-youtube px-2.5 py-1 text-xs font-bold text-white">Short</span>}
  </div>
  <h3 class="mt-3 font-semibold leading-snug text-foreground group-hover:text-blue-ink">{video.title.replace(/\s*#\S+/g, "")}</h3>
  <p class="mt-1 text-sm text-muted-foreground"><time datetime={video.published}>{shortDate(video.published)}</time></p>
</a>
