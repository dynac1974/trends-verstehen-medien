---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Seite nicht gefunden">
  <section class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
    <img src="/img/tim-wave.png" alt="" width="871" height="900" class="mx-auto w-48" />
    <h1 class="mt-6 text-4xl font-black">Hier gibt’s (noch) keinen Trend.</h1>
    <p class="mt-3 text-lg text-muted-foreground">Die Seite wurde nicht gefunden. Vielleicht findest du im Blog, was du suchst.</p>
    <p class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-control bg-primary px-6 py-3 font-bold text-white no-underline">Zur Startseite</a>
      <a href="/blog" class="rounded-control border border-border bg-card px-6 py-3 font-bold text-foreground no-underline">Zum Blog</a>
    </p>
  </section>
</SiteLayout>
